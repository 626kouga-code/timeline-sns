{
  "name": "timeline-sns-e2e",
  "private": true,
  "description": "Playwright の E2E テストとブラウザ性能の計測（docs/08）",
  "type": "module",
  "scripts": {
    "test": "node scripts/reset-db.mjs && playwright test",
    "test:e2e": "node scripts/reset-db.mjs && playwright test --project e2e",
    "test:load": "node scripts/reset-db.mjs && cross-env E2E_LOAD=1 playwright test",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@playwright/test": "~1.65.1",
    "@types/node": "^24.19.1",
    "cross-env": "^10.1.0",
    "playwright-core": "~1.65.1",
    "typescript": "~6.0.3"
  }
}
